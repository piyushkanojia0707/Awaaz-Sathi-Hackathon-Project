{
  "manifest_version": 3,
  "name": "Input Highlighter",
  "version": "1.1",
  "description": "Learning project: voice form filler + live screen AI",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "tabCapture", "storage"],
  "host_permissions": ["<all_urls>", "https://generativelanguage.googleapis.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
